<Window x:Class="AnzenSecurityWatcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Settings_WindowTitle}"
        Width="540" Height="640"
        MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#B4232C"/>
            <Setter Property="BorderBrush" Value="#F85149"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="BorderBrush" Value="#388BFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 0. 言語設定 (Language Selection) -->
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrushPrimary}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Settings_LangTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextStrongBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Loc_Settings_LangDesc}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <UniformGrid Columns="2">
                            <RadioButton x:Name="LangEnRadio" Content="{DynamicResource Loc_Settings_LangEn}"
                                         GroupName="AppLanguageGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,6,6"
                                         Checked="LanguageRadio_Checked"/>
                            <RadioButton x:Name="LangZhRadio" Content="{DynamicResource Loc_Settings_LangZh}"
                                         GroupName="AppLanguageGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,6"
                                         Checked="LanguageRadio_Checked"/>
                            <RadioButton x:Name="LangEsRadio" Content="{DynamicResource Loc_Settings_LangEs}"
                                         GroupName="AppLanguageGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,6,0"
                                         Checked="LanguageRadio_Checked"/>
                            <RadioButton x:Name="LangJaRadio" Content="{DynamicResource Loc_Settings_LangJa}"
                                         GroupName="AppLanguageGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,0"
                                         Checked="LanguageRadio_Checked"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 1. 外観・テーマ設定 -->
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrushPrimary}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Settings_ThemeTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextStrongBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Loc_Settings_ThemeDesc}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <RadioButton x:Name="ThemeSystemRadio" Content="{DynamicResource Loc_Settings_ThemeSystem}"
                                     GroupName="AppThemeGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,6"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="{DynamicResource Loc_Settings_ThemeLight}"
                                     GroupName="AppThemeGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,6"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="ThemeDarkRadio" Content="{DynamicResource Loc_Settings_ThemeDark}"
                                     GroupName="AppThemeGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"
                                     Checked="ThemeRadio_Checked"/>
                    </StackPanel>
                </Border>

                <!-- 2. スキャン間隔 / 省電力設定 -->
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrushPrimary}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Settings_ScanIntervalTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextStrongBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Loc_Settings_ScanIntervalDesc}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <RadioButton x:Name="ScanIntervalFastRadio" Content="{DynamicResource Loc_Settings_ScanIntervalFast}"
                                     GroupName="ScanIntervalGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,6"
                                     Checked="ScanIntervalRadio_Checked"/>
                        <RadioButton x:Name="ScanIntervalStandardRadio" Content="{DynamicResource Loc_Settings_ScanIntervalStandard}"
                                     GroupName="ScanIntervalGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,6"
                                     Checked="ScanIntervalRadio_Checked"/>
                        <RadioButton x:Name="ScanIntervalPowerSavingRadio" Content="{DynamicResource Loc_Settings_ScanIntervalPowerSaving}"
                                     GroupName="ScanIntervalGroup"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"
                                     Checked="ScanIntervalRadio_Checked"/>
                    </StackPanel>
                </Border>

                <!-- 3. 監視・プライバシーオプション -->
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrushPrimary}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Settings_OptionsTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextStrongBrush}" Margin="0,0,0,8"/>

                        <CheckBox x:Name="IncludeLoopbackCheck" Content="{DynamicResource Loc_Settings_OptLoopback}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,8"
                                  Click="OptionsCheck_Clicked"/>
                        <CheckBox x:Name="IncludeListenCheck" Content="{DynamicResource Loc_Settings_OptListen}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,8"
                                  Click="OptionsCheck_Clicked"/>
                        <CheckBox x:Name="IncludeUdpCheck" Content="{DynamicResource Loc_Settings_OptUdp}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,8"
                                  Click="OptionsCheck_Clicked"/>
                        <CheckBox x:Name="EnableDllSideloadCheck" Content="{DynamicResource Loc_Settings_OptDllSideload}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,8"
                                  Click="OptionsCheck_Clicked"/>
                        <CheckBox x:Name="MaskPersonalInfoCheck" Content="{DynamicResource Loc_Settings_OptMaskPii}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,8"
                                  Click="OptionsCheck_Clicked"/>
                        <CheckBox x:Name="DisableOnlineGeoIpCheck" Content="{DynamicResource Loc_Settings_OptDisableOnlineGeoIp}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"
                                  Click="OptionsCheck_Clicked"/>
                    </StackPanel>
                </Border>

                <!-- 4. 警報・異常テスト発報 -->
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrushPrimary}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Settings_SimTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextStrongBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Loc_Settings_SimDesc}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Button Style="{StaticResource DangerDialogButton}"
                                Content="{DynamicResource Loc_Settings_SimAllBtn}"
                                Padding="12,8" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                Click="SimAllButton_Click"/>

                        <TextBlock Text="{DynamicResource Loc_Settings_SimIndividualLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Style="{StaticResource DialogButton}" Content="{DynamicResource Loc_Settings_SimAnyDeskBtn}" Margin="0,0,4,6" Click="SimAnyDeskButton_Click"/>
                            <Button Style="{StaticResource DialogButton}" Content="{DynamicResource Loc_Settings_SimZoomBtn}" Margin="4,0,0,6" Click="SimZoomButton_Click"/>
                            <Button Style="{StaticResource DialogButton}" Content="{DynamicResource Loc_Settings_SimRdpBtn}" Margin="0,0,4,0" Click="SimRdpButton_Click"/>
                            <Button Style="{StaticResource DialogButton}" Content="{DynamicResource Loc_Settings_SimProcessBtn}" Margin="4,0,0,0" Click="SimProcessButton_Click"/>
                        </UniformGrid>
                        <Button Style="{StaticResource DialogButton}"
                                Content="{DynamicResource Loc_Settings_SimDefenseBtn}"
                                Padding="10,6" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                Click="SimDefenseButton_Click"/>

                        <Button Style="{StaticResource DialogButton}"
                                Content="{DynamicResource Loc_Settings_ClearSimBtn}"
                                Padding="10,6" HorizontalAlignment="Stretch"
                                Click="ClearSimButton_Click"/>

                        <TextBlock x:Name="TestActionStatusText"
                                   Text=""
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 下部ボタン -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Loc_Settings_RealtimeNote}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
            <Button Style="{StaticResource PrimaryDialogButton}" Content="{DynamicResource Loc_Settings_CloseBtn}" Width="100" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
